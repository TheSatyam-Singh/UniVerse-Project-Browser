<UserControl
    x:Class="UniVerseProjectBrowser.Controls.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UniVerseProjectBrowser.Controls"
    xmlns:viewmodels="using:UniVerseProjectBrowser.ViewModels"
    Background="{StaticResource UniverseSidebarBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListView
            Grid.Row="0"
            ItemsSource="{x:Bind Sidebar.Profiles, Mode=OneWay}"
            SelectionMode="Single"
            SelectedItem="{x:Bind Sidebar.SelectedProfile, Mode=TwoWay}"
            SelectionChanged="Profiles_SelectionChanged"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.VerticalScrollMode="Disabled"
            Margin="8,12,8,4">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ProfileViewModel">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{x:Bind ProfileBrush, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Initial, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <controls:AddressBarView x:Name="AddressBar" Grid.Row="1" Margin="8,4,8,4" />
        <TextBlock Grid.Row="2" Text="Pinned" Foreground="{StaticResource UniverseSidebarForeground}" Opacity="0.6" FontSize="11" Margin="12,8,12,2" />
        <GridView
            Grid.Row="3"
            ItemsSource="{x:Bind Sidebar.PinnedTabs, Mode=OneWay}"
            SelectionMode="Single"
            SelectedItem="{x:Bind Sidebar.ActiveTab, Mode=TwoWay}"
            Margin="8,0,8,4"
            IsItemClickEnabled="True"
            ItemClick="PinnedGrid_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:TabViewModel">
                    <Border Width="64" Height="64" CornerRadius="12" Background="{StaticResource UniversePinnedTileBackground}" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ShortTitle, Mode=OneWay}" Foreground="{StaticResource UniverseSidebarForeground}" FontSize="12" TextWrapping="Wrap" Margin="6" />
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind Sidebar.Tabs, Mode=OneWay}"
            SelectionMode="Single"
            SelectedItem="{x:Bind Sidebar.ActiveTab, Mode=TwoWay}"
            SelectionChanged="Tabs_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:TabViewModel">
                    <Grid Padding="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Title, Mode=OneWay}" Foreground="{StaticResource UniverseSidebarForeground}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="CloseTabButton_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Close tab" Background="Transparent" BorderThickness="0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="8" Spacing="8">
            <Button Content="New Tab" Click="NewTabButton_Click" />
            <Button Content="New Profile" Click="NewProfileButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
