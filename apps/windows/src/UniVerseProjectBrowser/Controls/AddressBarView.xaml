<UserControl
    x:Class="UniVerseProjectBrowser.Controls.AddressBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
            x:Name="Input"
            Grid.Column="0"
            PlaceholderText="Search or type a URL"
            Text="{x:Bind AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            KeyDown="Input_KeyDown"
            GotFocus="Input_GotFocus" />
        <Button Grid.Column="1" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" Click="GoButton_Click" ToolTipService.ToolTip="Go" />
    </Grid>
</UserControl>
